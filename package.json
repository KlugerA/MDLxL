{
  "name": "mdlxl",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "MDLxL Warcraft III model editor",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:source": "node --test test/*.test.js",
    "test:compatibility": "node --test tests/*.test.js",
    "dev": "vite --host 127.0.0.1",
