    "lucide-react": "0.577.0",
    "buffer": "6.0.3",
    "clipper-lib": "6.4.2"
  },
  "devDependencies": {
    "vite": "7.3.1",
    "electron": "40.8.0",
    "@electron/packager": "19.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "productName": "MDLxL"
